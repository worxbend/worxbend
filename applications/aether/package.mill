package build.applications.aether

import build.applications.WxSbtModule

import mill._
import mill.scalalib._

object `package` extends WxSbtModule {

  def mainClass = Some("io.worxbend.aether.AetherApp")

  def mvnDeps = super.mvnDeps() ++ Seq(
    // Tapir + Netty sync — Java 21 virtual threads, direct style
    mvn"com.softwaremill.sttp.tapir::tapir-netty-server-sync:1.14.1",
    mvn"com.softwaremill.sttp.tapir::tapir-json-circe:1.14.1",
    mvn"com.softwaremill.sttp.tapir::tapir-swagger-ui-bundle:1.14.1",
    // Structured concurrency
    mvn"com.softwaremill.ox::core:1.1.0",
    // JSON
    mvn"io.circe::circe-core:0.14.17",
    mvn"io.circe::circe-generic:0.14.17",
    mvn"io.circe::circe-parser:0.14.17",
    // HTTP client (outbound requests to AirGradient device)
    mvn"com.softwaremill.sttp.client4::core:4.1.1",
    mvn"com.softwaremill.sttp.client4::circe:4.1.1",
    // Configuration
    mvn"com.github.pureconfig::pureconfig-core:0.17.11",
    mvn"com.github.pureconfig::pureconfig-generic-scala3:0.17.11",
    // Logging
    mvn"ch.qos.logback:logback-classic:1.6.6",
  )
}
