package build.applications.`airgradient-proxy`

import build.applications.WxSbtModule
import mill._
import mill.scalalib._
import mill.scalalib.scalafmt.ScalafmtModule

object `package` extends WxSbtModule with ScalafmtModule {

  override def scalacOptions = super.scalacOptions().filter(_ != "-Xmigration") ++ Seq(
    "-release:21"
  )

  override def javacOptions = Seq(
    "--release",
    "21",
  )

  def mvnDeps = super.mvnDeps() ++ Seq(
    // Tapir Netty sync server (direct-style, virtual-thread friendly)
    mvn"com.softwaremill.sttp.tapir::tapir-netty-server-sync:1.14.1",
    mvn"com.softwaremill.sttp.tapir::tapir-core:1.14.1",
    mvn"com.softwaremill.sttp.tapir::tapir-jsoniter-scala:1.14.1",

    // ox structured concurrency for lifecycle and polling
    mvn"com.softwaremill.ox::core:1.1.0",

    // sttp4 client: Tapir endpoint → typed HTTP call, OkHttp 5 as the sync transport
    mvn"com.softwaremill.sttp.tapir::tapir-sttp-client4:1.14.1",
    mvn"com.softwaremill.sttp.client4::okhttp-backend:4.1.1",

    // jsoniter-scala JSON validation + internal status codecs
    mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-core:2.42.3",
    mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-macros:2.42.3",

    // pureconfig configuration loading
    mvn"com.github.pureconfig::pureconfig-core:0.17.11",

    // distage dependency injection
    mvn"io.7mind.izumi::distage-core:1.2.25",

    // logstage structured logging
    mvn"io.7mind.izumi::logstage-core:1.2.25",
    mvn"io.7mind.izumi::logstage-sink-slf4j:1.2.25",

    // slf4j + logback for logstage sink
    mvn"org.slf4j:slf4j-api:2.0.20",
    mvn"ch.qos.logback:logback-classic:1.6.6",

    // Tapir observability + docs
    mvn"com.softwaremill.sttp.tapir::tapir-apispec-docs:1.14.1",
    // JSON serialization for sttp.apispec.Schema (test-scoped in tapir-apispec-docs, so explicit here)
    mvn"com.softwaremill.sttp.apispec::jsonschema-circe:0.12.1",
    mvn"com.softwaremill.sttp.tapir::tapir-prometheus-metrics:1.14.1",
    mvn"com.softwaremill.sttp.tapir::tapir-opentelemetry-tracing:1.14.1",
    // OpenTelemetry SDK autoconfigure reads OTEL_* env vars at startup
    mvn"io.opentelemetry:opentelemetry-sdk-extension-autoconfigure:1.68.0",
  )

  object test extends SbtTests with ScalafmtModule {

    def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"org.scalameta::munit:1.3.6",
      mvn"org.wiremock:wiremock-standalone:3.13.2",
    )

    def testFramework = "munit.Framework"

  }

}
