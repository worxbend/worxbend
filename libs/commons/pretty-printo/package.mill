package build.libs.commons.`pretty-printo`

import mill._
import mill.javalib._
import mill.javalib.publish._
import mill.scalalib.SbtModule
import mill.scalalib.scalafmt.ScalafmtModule

object `package` extends SbtModule with PublishModule with ScalafmtModule { outer =>

  // Without this, Mill derives the artifact id from the module path and publishes
  // `libs-commons-pretty-printo`, leaking the repository's build layout into the coordinates
  // consumers depend on.
  def artifactName = "pretty-printo"

  def scalaVersion = "3.10.0"

  def scalacOptions = Seq("-Wunused:all", "-deprecation", "-feature", "-Werror")

  def mvnDeps = super.mvnDeps() ++
    Seq(mvn"com.softwaremill.magnolia1_3::magnolia:1.3.24")

  def pomSettings = PomSettings(
    description = "Scala 3 configurable toString derivation via Magnolia typeclass derivation. Supports @Redacted, @Excluded annotations and rich formatting configuration.",
    organization = "com.worxbend",
    url = "https://github.com/worxbend/worxbend",
    licenses = Seq(License.`GPL-2.0-only`),
    versionControl = VersionControl.github("worxbend", "worxbend"),
    developers = Seq(Developer("limpid-kzonix", "limpid-kzonix", "https://github.com/limpid-kzonix")),
  )

  def publishVersion = "0.1.0-SNAPSHOT"

  object test extends SbtTests with TestModule.ScalaTest with ScalafmtModule {

    def scalacOptions = outer.scalacOptions()


    def mvnDeps = super.mvnDeps() ++ Seq(mvn"org.scalatest::scalatest:3.2.20")

    def testSandboxWorkingDir = false
    def testEnableWorkStealing = false
  }
}
