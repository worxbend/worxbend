package build.libs.commons.dscrbo

import mill._
import mill.javalib._
import mill.javalib.publish._
import mill.scalalib.SbtModule
import mill.scalalib.scalafmt.ScalafmtModule

object `package` extends SbtModule with PublishModule with ScalafmtModule { outer =>

  def scalaVersion = "3.8.4"

  def scalacOptions = Seq("-Wunused:all", "-deprecation", "-feature")

  def pomSettings = PomSettings(
    description = "Scala 3 configurable toString via inline macros with zero external dependencies. Supports @Redacted, @Excluded annotations and rich formatting configuration.",
    organization = "io.worxbend",
    url = "https://github.com/worxbend/worxbend",
    licenses = Seq(License.MIT),
    versionControl = VersionControl.github("worxbend", "worxbend"),
    developers = Seq(Developer("limpid-kzonix", "limpid-kzonix", "https://github.com/limpid-kzonix")),
  )

  def publishVersion = "0.1.0-SNAPSHOT"

  object test extends SbtTests with TestModule.ScalaTest with ScalafmtModule {

    // The macro expands at the *use* site, so `-Xcheck-macros` only checks anything when it is set here rather than on
    // the module that defines the macro. It validates the trees and types `DescribeMacro` hand-builds outside a quote
    // (`Select`, `AppliedType`, `Ref`), and detects scope extrusion — which matters because `Expansion` deliberately
    // captures one `Quotes`. Deliberately kept off the published module so consumers do not pay for the check.
    def scalacOptions = outer.scalacOptions() ++ Seq("-Xcheck-macros")

    // The conformance kit is test-scope only, so it never reaches this module's published dependencies.
    def moduleDeps = super.moduleDeps ++ Seq(build.libs.commons.`describo-tck`)

    def mvnDeps = super.mvnDeps() ++ Seq(mvn"org.scalatest::scalatest:3.2.20")

    def testSandboxWorkingDir = false
    def testEnableWorkStealing = false
  }
}
